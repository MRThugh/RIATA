{
  "folders": {
    "دانلود": "Downloads",
    "دانلودها": "Downloads",
    "اسناد": "Documents",
    "داکیومنت": "Documents",
    "داکیومنتس": "Documents",
    "مدارک": "Documents",
    "تصاویر": "Pictures",
    "تصویر": "Pictures",
    "عکس": "Pictures",
    "عکسها": "Pictures",
    "عکس ها": "Pictures",
    "پیکچرز": "Pictures",
    "موزیک": "Music",
    "اهنگ": "Music",
    "اهنگها": "Music",
    "موسیقی": "Music",
    "موزیک ها": "Music",
    "ویدیو": "Videos",
    "ویدیوها": "Videos",
    "ویدیو ها": "Videos",
    "فیلم": "Videos",
    "فیلمها": "Videos",
    "فیلم ها": "Videos",
    "دسکتاپ": "Desktop",
    "میزکار": "Desktop",
    "میز کار": "Desktop",
    "خانه": "Home",
    "پوشه خانگی": "Home",
    "اصلی": "Home"
  },
  "ordinals": {
    "اول": 1,
    "اولی": 1,
    "اولین": 1,
    "دوم": 2,
    "دومی": 2,
    "دومین": 2,
    "سوم": 3,
    "سومی": 3,
    "سومین": 3,
    "چهارم": 4,
    "چهارمی": 4,
    "پنجم": 5,
    "پنجمی": 5
  },
  "application_patterns": [
    "^(?:برنامه\\s+)?(?P<app>.+?)\\s+(?:رو|را|رو\\s+هم|را\\s+هم)\\s+(?:باز\\s*کن|اجرا\\s*کن|استارت\\s*بزن|استارت\\s*کن)$",
    "^(?:برنامه\\s+)?(?P<app>.+?)\\s+(?:باز\\s*کن|اجرا\\s*کن|استارت\\s*بزن)$",
    "^(?:باز\\s*کن|اجرا\\s*کن)\\s+(?:برنامه\\s+)?(?P<app>.+?)$"
  ],
  "application_prefixes_to_strip": ["برنامه", "اپلیکیشن"],
  "application_suffixes_to_strip": ["رو", "را"],
  "folder_patterns": [
    "^(?:پوشه|فولدر)\\s+(?P<folder>.+?)(?:\\s+رو)?(?:\\s+باز\\s*کن|\\s+نشون\\s*بده)?$",
    "^(?:پوشه|فولدر)\\s+(?P<folder>.+)$"
  ],
  "song_patterns": [
    "^(?:اهنگ|موزیک|موسیقی)\\s+(?P<song>.+?)\\s+(?:رو\\s+)?(?:پخش\\s*کن|پلی\\s*کن|بذار)$",
    "^پخش\\s+(?:اهنگ|موزیک)\\s+(?P<song>.+)$"
  ],
  "song_ignore_words": ["یه", "یک", "رو", "را"],
  "file_patterns": [
    "^فایل\\s+(?P<file>.+?)(?:\\s+رو)?\\s+(?:باز\\s*کن|اجرا\\s*کن)$"
  ]
}
