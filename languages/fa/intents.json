{
  "intents": {
    "OPEN_TERMINAL": {
      "patterns": [
        "^ترمینال(\\s+رو)?(\\s+باز\\s*کن|\\s+اجرا\\s*کن)?$",
        "^terminal(\\s+رو)?(\\s+باز\\s*کن|\\s+اجرا\\s*کن)?$",
        "^کنسول(\\s+رو)?(\\s+باز\\s*کن)?$"
      ],
      "keywords": ["ترمینال", "terminal", "کنسول"]
    },
    "OPEN_FILE_MANAGER": {
      "patterns": [
        "^فایل\\s*منیجر(\\s+رو)?(\\s+باز\\s*کن|\\s+اجرا\\s*کن)?$",
        "^فایل\\s*ها(\\s+رو)?(\\s+باز\\s*کن)?$",
        "^مدیریت\\s+فایل(\\s+رو)?(\\s+باز\\s*کن)?$",
        "^file\\s*manager(\\s+رو)?(\\s+باز\\s*کن)?$"
      ],
      "keywords": ["فایل منیجر", "مدیریت فایل", "فایلها", "فایل ها"]
    },
    "OPEN_SETTINGS": {
      "patterns": [
        "^تنظیمات(\\s+سیستم)?(\\s+رو)?(\\s+باز\\s*کن|\\s+نشون\\s*بده)?$",
        "^کنترل\\s*پنل(\\s+رو)?(\\s+باز\\s*کن)?$",
        "^settings(\\s+رو)?(\\s+باز\\s*کن)?$"
      ],
      "keywords": ["تنظیمات", "settings", "تنظیمات سیستم"]
    },
    "SHOW_SYSTEM_INFO": {
      "patterns": [
        "^(مشخصات|اطلاعات|وضعیت)\\s+سیستم(\\s+رو)?(\\s+نشون\\s*بده|\\s+بگو)?$",
        "^سیستم\\s+اینفو$",
        "^system\\s+info$"
      ],
      "keywords": ["مشخصات سیستم", "اطلاعات سیستم", "وضعیت سیستم", "سیستم اینفو"]
    },
    "TAKE_SCREENSHOT": {
      "patterns": [
        "^اسکرین\\s*شات(\\s+بگیر|\\s+رو\\s+بگیر)?$",
        "^عکس\\s+از\\s+صفحه(\\s+بگیر)?$",
        "^screenshot(\\s+بگیر)?$"
      ],
      "keywords": ["اسکرین شات", "عکس از صفحه", "screenshot"]
    },
    "EXIT_APPLICATION": {
      "patterns": [
        "^(ریاتا|برنامه)(\\s+رو)?(\\s+ببند|\\s+بستن)$",
        "^خروج$",
        "^بای$",
        "^خداحافظ$",
        "^بسته\\s*شو$"
      ],
      "keywords": ["خروج", "ببند", "خداحافظ", "بسته شو"]
    },
    "PLAY_MUSIC": {
      "patterns": [
        "^(اهنگ|موزیک|موسیقی)\\s+(.+?)\\s+(رو\\s+)?(پخش\\s*کن|پلی\\s*کن|بذار)$",
        "^(اهنگ|موزیک|موسیقی)\\s+(پخش\\s*کن|پلی\\s*کن|بذار)$",
        "^یه\\s+(اهنگ|موزیک)\\s+(پخش\\s*کن|بذار)$",
        "^پخش\\s+(اهنگ|موزیک)(\\s+(.+))?$"
      ],
      "keywords": ["اهنگ", "موزیک", "موسیقی", "پخش", "پلی"]
    },
    "RESET_CONTEXT": {
      "patterns": [
        "^(فراموشش\\s*کن|شروع\\s*دوباره|بازنشانی|ریست|لغو\\s*زمینه)$"
      ],
      "keywords": ["فراموشش کن", "شروع دوباره", "بازنشانی"]
    },
    "CLOSE_APPLICATION": {
      "patterns": [
        "^(?:برنامه\\s+)?(.+?)\\s+(?:رو\\s+)?ببند$",
        "^ببند\\s+(?:برنامه\\s+)?(.+?)$",
        "^ببندش$",
        "^ببند$"
      ],
      "keywords": ["ببند", "ببندش", "بستن"]
    },
    "CREATE_FILE": {
      "patterns": [
        "^(?:داخلش|توش|در\\s*آن)?\\s*(?:فایل\\s+)?(.+?)\\s+(?:رو\\s+)?(?:بساز|ایجاد\\s*کن)$",
        "^(?:فایل\\s+)?(.+?)\\s+(?:رو\\s+)?(?:بساز|ایجاد\\s*کن)$"
      ],
      "keywords": ["بساز", "ایجاد کن"]
    },
    "DELETE_FILE": {
      "patterns": [
        "^(?:فایل\\s+)?(.+?)\\s+(?:رو\\s+)?(?:حذف\\s*کن|پاک\\s*کن|دیلیت\\s*کن)$",
        "^(?:حذفش|پاکش|دیلیتش)\\s*کن$",
        "^حذف\\s+(?:فایل\\s+)?(.+?)$"
      ],
      "keywords": ["حذف کن", "پاک کن", "دیلیت کن", "حذفش کن"]
    },
    "OPEN_FILE": {
      "patterns": [
        "^فایل\\s+(.+?)(?:\\s+رو)?(?:\\s+باز\\s*کن)$",
        "^فایل\\s+(.+)$"
      ],
      "keywords": ["فایل"]
    },
    "OPEN_FOLDER": {
      "patterns": [
        "^(پوشه|فولدر)\\s+(.+?)(?:\\s+رو)?(?:\\s+باز\\s*کن|\\s+نشون\\s*بده)$",
        "^(پوشه|فولدر)\\s+(.+)$"
      ],
      "keywords": ["پوشه", "فولدر"]
    },
    "OPEN_URL": {
      "patterns": [
        "^(?:سایت|وبسایت|آدرس|یوآرال|لینک)\\s+(.+?)(?:\\s+رو)?(?:\\s+باز\\s*کن)?$",
        "^(https?://\\S+|www\\.\\S+)(?:\\s+رو)?(?:\\s+باز\\s*کن)?$"
      ],
      "keywords": ["سایت", "وبسایت", "لینک"]
    },
    "OPEN_APPLICATION": {
      "patterns": [
        "^برنامه\\s+(.+?)\\s+(رو\\s+)?(باز\\s*کن|اجرا\\s*کن|استارت\\s*بزن|استارت\\s*کن)$",
        "^(.+?)\\s+(رو\\s+)?(باز\\s*کن|اجرا\\s*کن|استارت\\s*بزن|استارت\\s*کن)$",
        "^(باز\\s*کن|اجرا\\s*کن)\\s+(.+?)$"
      ],
      "keywords": ["باز کن", "اجرا کن", "استارت"]
    }
  }
}
