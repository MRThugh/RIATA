{
  "intents": {
    "OPEN_TERMINAL": {
      "patterns": [
        "^(open|launch|start|run)?\\s*terminal$",
        "^(open|launch|start)?\\s*console$",
        "^terminal$"
      ],
      "keywords": ["terminal", "console"]
    },
    "OPEN_FILE_MANAGER": {
      "patterns": [
        "^(open|launch|start)?\\s*file\\s*manager$",
        "^(open|launch)?\\s*files$",
        "^file\\s*manager$"
      ],
      "keywords": ["file manager", "files"]
    },
    "OPEN_SETTINGS": {
      "patterns": [
        "^(open|launch|show)?\\s*(system\\s+)?settings$",
        "^(open|launch)?\\s*control\\s*center$",
        "^settings$"
      ],
      "keywords": ["settings", "control center"]
    },
    "SHOW_SYSTEM_INFO": {
      "patterns": [
        "^(show|display|get)?\\s*system\\s*(info|information|specs)$",
        "^system\\s*info$",
        "^about\\s*system$"
      ],
      "keywords": ["system info", "system information", "system specs"]
    },
    "TAKE_SCREENSHOT": {
      "patterns": [
        "^(take|capture)(\\s+a)?\\s*screenshot$",
        "^capture\\s+screen$",
        "^screenshot$"
      ],
      "keywords": ["screenshot", "capture screen"]
    },
    "EXIT_APPLICATION": {
      "patterns": [
        "^(exit|quit|close)(\\s+riata)?$",
        "^bye$",
        "^goodbye$"
      ],
      "keywords": ["exit", "quit", "close", "bye", "goodbye"]
    },
    "PLAY_MUSIC": {
      "patterns": [
        "^play\\s+(music|a\\s+song|song)$",
        "^play\\s+(.+)$",
        "^start\\s+music$"
      ],
      "keywords": ["play", "music", "song"]
    },
    "RESET_CONTEXT": {
      "patterns": [
        "^(forget\\s+it|reset\\s+context|start\\s+over|clear\\s+context)$"
      ],
      "keywords": ["forget it", "reset context", "start over"]
    },
    "CLOSE_APPLICATION": {
      "patterns": [
        "^(close|quit|exit|terminate)\\s+(app|application\\s+)?(.+)$",
        "^close\\s+it$",
        "^close$"
      ],
      "keywords": ["close", "quit", "terminate"]
    },
    "CREATE_FILE": {
      "patterns": [
        "^(?:create|make|touch)\\s+(?:file\\s+)?(.+?)(?:\\s+(?:in|inside)\\s+it)?$",
        "^(?:create|make|touch)\\s+(.+?)\\s+in\\s+(.+)$"
      ],
      "keywords": ["create", "make", "touch"]
    },
    "DELETE_FILE": {
      "patterns": [
        "^(?:delete|remove|rm)\\s+(?:file\\s+)?(.+)$",
        "^(?:delete|remove)\\s+it$"
      ],
      "keywords": ["delete", "remove"]
    },
    "OPEN_FILE": {
      "patterns": [
        "^open\\s+file\\s+(.+)$"
      ],
      "keywords": ["open file"]
    },
    "OPEN_FOLDER": {
      "patterns": [
        "^(open|show|explore)\\s+(?:my\\s+)?folder\\s+(.+)$",
        "^(open|show|explore)\\s+(?:my\\s+)?(.+?)\\s+folder$",
        "^folder\\s+(.+)$"
      ],
      "keywords": ["folder"]
    },
    "OPEN_URL": {
      "patterns": [
        "^(?:open|launch)\\s+(?:url|website|site|link)\\s+(.+)$",
        "^(?:open|launch)\\s+(https?://\\S+)$"
      ],
      "keywords": ["open url", "website"]
    },
    "OPEN_APPLICATION": {
      "patterns": [
        "^(open|launch|start|run)\\s+(app|application\\s+)?(.+)$"
      ],
      "keywords": ["open", "launch", "start", "run"]
    }
  }
}
